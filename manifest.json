{
  "manifest_version": 3,
  "name": "AQW Lodestar",
  "version": "1.1.0",
  "description": "Item previews, merge/quest calculators and a farm list for AQW.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/lodestar16.png",
    "48": "icons/lodestar48.png",
    "128": "icons/lodestar128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "*://aqwwiki.wikidot.com/*",
    "*://account.aq.com/*",
    "*://aqcloset.com/*",
    "https://game.aq.com/*",
    "https://www.artix.com/*",
    "https://raw.githubusercontent.com/*",
    "https://i.imgur.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AQW Lodestar",
    "default_icon": {
      "16": "icons/lodestar16.png",
      "48": "icons/lodestar48.png",
      "128": "icons/lodestar128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://aqwwiki.wikidot.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/text.js",
        "shared/image-proxy.js",
        "shared/inventory.js",
        "shared/messaging.js",
        "shared/rarity.js",
        "shared/wiki-parser.js",
        "shared/aqcloset.js",
        "shared/farm-entry.js",
        "content/page.js",
        "content/item-preview.js",
        "content/hover-tooltip.js",
        "content/farm-context.js",
        "content/owned-marks.js",
        "content/theme.js",
        "content/merge-calc.js",
        "content/wiki-images.js",
        "content/farm-buttons.js",
        "content/try-on-buttons.js",
        "content/item-lists.config.js",
        "content/item-lists.js",
        "content/collection-progress.js"
      ],
      "css": [
        "content/base.css",
        "shared/rarity.css",
        "content/item-preview.css",
        "content/farm-context.css",
        "content/owned-marks.css",
        "content/theme.css",
        "content/merge-calc.css",
        "content/item-lists.css",
        "content/collection-progress.css",
        "content/farm-buttons.css",
        "content/try-on-buttons.css"
      ]
    },
    {
      "matches": [
        "*://account.aq.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/text.js",
        "shared/image-proxy.js",
        "shared/inventory.js",
        "shared/messaging.js",
        "shared/rarity.js",
        "shared/wiki-parser.js",
        "shared/aqcloset.js",
        "shared/farm-entry.js",
        "content/page.js",
        "content/item-preview.js",
        "content/hover-tooltip.js",
        "content/farm-context.js",
        "content/owned-marks.js",
        "content/theme.js",
        "render/capture.js",
        "content/inventory-sync.js",
        "content/account-page.js",
        "content/inventory-sections.js"
      ],
      "css": [
        "content/base.css",
        "shared/rarity.css",
        "content/item-preview.css",
        "content/farm-context.css",
        "content/owned-marks.css",
        "content/theme.css",
        "content/inventory-sync.css",
        "content/account-page.css",
        "content/inventory-sections.css"
      ]
    },
    {
      "matches": [
        "*://aqcloset.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/text.js",
        "shared/image-proxy.js",
        "shared/inventory.js",
        "shared/messaging.js",
        "shared/rarity.js",
        "shared/wiki-parser.js",
        "shared/aqcloset.js",
        "shared/farm-entry.js",
        "content/page.js",
        "content/item-preview.js",
        "content/hover-tooltip.js",
        "content/farm-context.js",
        "content/owned-marks.js",
        "content/aqcloset-page.js",
        "content/reorder.js",
        "content/aqcloset-import.js"
      ],
      "css": [
        "content/base.css",
        "shared/rarity.css",
        "content/item-preview.css",
        "content/farm-context.css",
        "content/owned-marks.css",
        "content/aqcloset-page.css",
        "content/reorder.css",
        "content/aqcloset-import.css"
      ]
    },
    {
      "matches": [
        "*://account.aq.com/*"
      ],
      "js": [
        "render/main-world.js"
      ],
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "fonts/*"
      ],
      "matches": [
        "*://aqwwiki.wikidot.com/*",
        "*://account.aq.com/*",
        "*://aqcloset.com/*"
      ]
    },
    {
      "resources": [
        "render/*"
      ],
      "matches": [
        "*://account.aq.com/*"
      ]
    }
  ]
}
